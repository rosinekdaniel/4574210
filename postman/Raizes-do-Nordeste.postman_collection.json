{
  "info": {
    "name": "Rede Raízes do Nordeste - API",
    "_postman_id": "4e6a98d0-7b3e-4f70-ae5b-6d4f67f7d101",
    "description": "Coleção inicial para testar autenticação, pedidos, LGPD, estoque, fidelidade e promoções.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Cadastro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\"nome\": \"Maria de Teste\", \"email\": \"maria.teste@example.com\", \"senha\": \"senha-forte-123\"}"
        }
      }
    },
    {
      "name": "Login cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().access_token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"cliente@raizes.com\", \"senha\": \"12345678\"}"
        }
      }
    },
    {
      "name": "Listar produtos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/produtos"
      }
    },
    {
      "name": "Criar pedido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "pedido-demo-001"
          }
        ],
        "url": "{{baseUrl}}/api/pedidos",
        "body": {
          "mode": "raw",
          "raw": "{\"unidade_id\": 1, \"canal_pedido\": \"APP\", \"itens\": [{\"produto_id\": 1, \"quantidade\": 1}]}"
        }
      }
    },
    {
      "name": "Registrar consentimento LGPD",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/lgpd/consentimentos",
        "body": {
          "mode": "raw",
          "raw": "{\"finalidade\": \"Comunica\\u00e7\\u00e3o promocional\", \"consentido\": false, \"versao_termo\": \"1.0\"}"
        }
      }
    },
    {
      "name": "Consultar fidelidade",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/fidelidade"
      }
    },
    {
      "name": "Listar promoções",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/promocoes"
      }
    },
    {
      "name": "Consultar estoque",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/estoque?unidade_id=1"
      }
    }
  ]
}